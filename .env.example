VITE_API_BASE_URL=http://localhost:8000

DATABASE_URL=mysql+aiomysql://questkeeper:questkeeper@127.0.0.1:3306/questkeeper
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@questkeeper.local

# S3-compatible object storage for entity media (Garage in dev, real AWS S3 in prod).
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=questkeeper
S3_SECRET_KEY=questkeeper-dev-secret
S3_BUCKET=questkeeper-media
S3_REGION=garage

# Optional: creates (or promotes) this account to admin on startup, if no admin exists yet.
# Safe to leave set after the first admin exists - becomes a no-op.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
